# Minha App — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
PUID=1000
PGID=1000
APPDATA_PATH=/srv/appdata
CACHE_PATH=/srv/cache
MEDIA_PATH=/mnt/nas/media

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=minhaapp
POSTGRES_USER=minhaapp
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Minha App ─────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
MINHAAPP_SECRET_KEY=
# Opcional (padrão no compose: info)
# MINHAAPP_LOG_LEVEL=debug
