# Monitor — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
PUID=1000
PGID=1000
APPDATA_PATH=/srv/appdata
CACHE_PATH=/srv/cache

# ── Máquinas monitoradas ──────────────────────────────────────
# IPs na rede local (o Prometheus e o blackbox chegam por eles)
PROXMOX_IP=192.168.x.x
OMV_IP=192.168.x.x
OPNSENSE_IP=192.168.x.x
# IP da VPS dentro do túnel WireGuard (docs/09-infraestrutura-rede.md)
VPS_TUNNEL_IP=10.x.x.1

# ── Grafana ───────────────────────────────────────────────────
# Login de emergência (o formulário fica desligado; entra-se pelo Authentik).
# Gere com: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=
# Login pelo Authentik (OIDC). Passo a passo no README.md desta pasta.
GRAFANA_SSO_CLIENT_ID=
GRAFANA_SSO_CLIENT_SECRET=

# ── Alertas por e-mail (SMTP) ─────────────────────────────────
# Pode ser a mesma conta de SMTP do Authentik (AUTHENTIK_EMAIL__*).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=monitor@example.com
# MandatoryStartTLS (porta 587) ou NoStartTLS (porta 465, TLS direto)
SMTP_STARTTLS_POLICY=MandatoryStartTLS
# Quem recebe os alertas. Vários: separe por ";"
ALERTAS_EMAIL=voce@example.com

# ── Proxmox (pve-exporter) ────────────────────────────────────
# Token só leitura criado por hosts/proxmox/instalar.sh
PVE_USER=monitor@pve
PVE_TOKEN_NAME=prometheus
PVE_TOKEN_VALUE=

# ── OPNsense (opnsense-exporter) ──────────────────────────────
# Chave de API de um usuário só para o monitor (README, passo do OPNsense)
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=

# ── Retenção (opcionais) ──────────────────────────────────────
# Histórico de métricas: o que acabar primeiro. Logs: 30 dias (config/loki/loki.yml)
# PROMETHEUS_RETENTION=90d
# PROMETHEUS_RETENTION_SIZE=20GB
