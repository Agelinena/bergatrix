{
  "uid": "bergatrix-acessos",
  "title": "Acessos",
  "description": "Quem acessa os apps pelo Traefik: IP, país, operadora, app, erros e robôs. Países e operadoras: IP Geolocation by DB-IP (db-ip.com), CC BY 4.0",
  "tags": [
    "bergatrix"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "bergatrix"
      ],
      "asDropdown": false,
      "title": "Painéis",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "ip",
        "label": "IP (regex)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "type": "textbox",
        "name": "app",
        "label": "App (regex do endereço)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requisições",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"traefik\"} | json ClientHost=\"ClientHost\", RequestHost=\"RequestHost\", RequestPath=\"RequestPath\", DownstreamStatus=\"DownstreamStatus\" | ClientHost=~\"$ip\" | RequestHost=~\"$app\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
