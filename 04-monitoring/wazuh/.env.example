# Wazuh — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Primeira instalação: ./init.sh (cria as pastas em ${APPDATA_PATH}/wazuh e gera os certificados)

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
APPDATA_PATH=/srv/appdata

# ── Wazuh ─────────────────────────────────────────────────────
# Precisam bater com os hashes de config/wazuh_indexer/internal_users.yml
WAZUH_INDEXER_PASSWORD=
KIBANASERVER_PASSWORD=
WAZUH_API_PASSWORD=
