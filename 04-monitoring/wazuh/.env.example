# Caminho base para volumes persistentes (ex: /mnt/storage ou /opt/bergatrix)
STORAGE_PATH=/path/to/your/storage

# Domínio principal (ex: bergaestudio.xyz)
DOMAIN=yourdomain.com

# Senha do usuário admin do Wazuh Indexer e Dashboard
WAZUH_PASSWORD=changeme_strong_password

# Senha do usuário wazuh-wui (API interna do Wazuh Manager)
# Deve ter mínimo 8 caracteres, letras maiúsculas, minúsculas e número
WAZUH_API_PASSWORD=changeme_api_password

WAZUH_KIBANA_PASSWORD=