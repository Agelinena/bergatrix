# Authentik — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Este arquivo inteiro também vai para os containers (env_file), por isso as
# variáveis AUTHENTIK_* ficam com o nome que o Authentik espera.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
APPDATA_PATH=/srv/appdata

# ── Banco ─────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Authentik ─────────────────────────────────────────────────
# Gere com: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=
AUTHENTIK_ERROR_REPORTING__ENABLED=true

# SMTP (envio de e-mails: recuperação de senha, convites)
AUTHENTIK_EMAIL__HOST=smtp.example.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=authentik@example.com

# ── Outpost LDAP ──────────────────────────────────────────────
# Token do outpost LDAP: Applications → Outposts → (outpost LDAP) → informações de
# implantação. Sem prefixo AUTHENTIK_ porque este .env também vai para o server.
OUTPOST_LDAP_TOKEN=
