# Vaultwarden — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata

# ── Vaultwarden ───────────────────────────────────────────────
# Token do painel /admin. Use o hash argon2 (docker exec -it bitwarden
# /vaultwarden hash) entre aspas simples. Vazio desativa o painel.
VAULTWARDEN_ADMIN_TOKEN=

# ── SSO pelo Authentik (OIDC) ─────────────────────────────────
# Do provider "vaultwarden" no Authentik (Applications → Providers).
VAULTWARDEN_SSO_CLIENT_ID=
VAULTWARDEN_SSO_CLIENT_SECRET=
# true desliga o login por e-mail + senha mestra (só SSO). Comece em false.
VAULTWARDEN_SSO_ONLY=false
