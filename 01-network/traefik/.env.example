# Traefik — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
APPDATA_PATH=/srv/appdata

# ── Traefik ───────────────────────────────────────────────────
# Token da API do deSEC (desafio DNS do certificado wildcard *.${DOMAIN})
DESEC_TOKEN=
# O painel (traefik.${DOMAIN}) usa o login do Authentik (forward-auth).
# Chave do bouncer: docker exec crowdsec cscli bouncers add traefik-bouncer
CROWDSEC_BOUNCER_KEY=
