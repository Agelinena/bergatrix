# Bergakup — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.
# Os segredos do backup (senhas dos repositórios, chaves do B2, SMTP) NÃO
# ficam aqui: são digitados na interface e cifrados para o agente.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=bergakup
POSTGRES_USER=bergakup
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Login pelo Authentik (OIDC) ───────────────────────────────
# Passo a passo no README.md desta pasta.
BERGAKUP_OIDC_ISSUER=https://authentik.example.com/application/o/bergakup/
BERGAKUP_SSO_CLIENT_ID=
BERGAKUP_SSO_CLIENT_SECRET=
# Só quem está neste grupo do Authentik entra.
# BERGAKUP_USERS_GROUP=bergakup_admins

# ── Agente ────────────────────────────────────────────────────
# Porta da API para o agente, publicada só em 127.0.0.1 do host.
# BERGAKUP_AGENT_PORT=8087
