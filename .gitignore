# === Bergatrix: Proteção de Segredos ===
# Bloqueia todos os arquivos de variáveis de ambiente
.env
.env.*
!.env.example
**/AdGuardHome.yaml

# === Credenciais e Certificados ===
# Bloqueia chaves privadas e certificados (Traefik/Cloudflare)
*.pem
*.key
*.crt
*.pfx
*.csr
ssh_keys/
secrets/
**/acme.json
**/acme.json.*

# Bergakup: binário do agente e build da interface (gerados)
00-infrastructure/bergakup/agent/bergakup-agent
00-infrastructure/bergakup/web/node_modules/
00-infrastructure/bergakup/web/dist/

# claude-sync: o build renomeia o executável em uso para .exe~ (Windows)
ferramentas/claude-sync/*~

# graphify: só o grafo (graph.json, GRAPH_REPORT.md, manifest.json) vai para o git.
# Cache, visualização e estado local (tem o caminho desta máquina) ficam fora.
graphify-out/cache/
graphify-out/graph.html
graphify-out/.graphify_*

# Backups locais nunca vão pro git (ex.: acme.json.bak, *.bak.<timestamp>)
*.bak
*.bak.*


# === Infraestrutura e Volumes ===
# Não versão dados persistentes (bancos de dados, uploads)
**/data/
# Código de app que se chama "data" (camada de dados do Flutter), não volume.
!03-apps/berganews/frontend/lib/data/
!03-apps/doberga/frontend/lib/data/
**/db_data/
**/volumes/
**/backups/
**/downloads/
**/storage/
**/temp/

# Binários pesados / mídia (não versionar — ex.: jellyfin/temp/*.mkv, speedtest *.tgz)
*.mkv
*.mp4
*.avi
*.mov
*.tgz
*.tar.gz
*.iso

# === Logs e Runtime ===
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Arquivos de Sistema (OS) ===
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.claude

# === IDEs e Editores ===
.vscode/
.idea/
*.swp
*.swo
.history/

# === Python / Node (Caso use scripts de automação) ===
__pycache__/
node_modules/
dist/
build/


# Repositórios de código das stacks (repos.txt): cada um tem o próprio git
03-apps/*/repos/
