# === Bergatrix: Proteção de Segredos ===
# Bloqueia todos os arquivos de variáveis de ambiente
.env
.env.*
!.env.example
**/AdGuardHome.yaml

# === Credenciais e Certificados ===
# Bloqueia chaves privadas e certificados (Traefik/Cloudflare)
*.pem
*.key
*.crt
*.pfx
*.csr
ssh_keys/
secrets/
**/acme.json
**/acme.json.*

# Backups locais nunca vão pro git (ex.: acme.json.bak, *.bak.<timestamp>)
*.bak
*.bak.*


# === Infraestrutura e Volumes ===
# Não versão dados persistentes (bancos de dados, uploads)
**/data/
**/db_data/
**/volumes/
**/backups/
**/downloads/
**/storage/
**/temp/

# Binários pesados / mídia (não versionar — ex.: jellyfin/temp/*.mkv, speedtest *.tgz)
*.mkv
*.mp4
*.avi
*.mov
*.tgz
*.tar.gz
*.iso

# === Logs e Runtime ===
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Arquivos de Sistema (OS) ===
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.claude

# === IDEs e Editores ===
.vscode/
.idea/
*.swp
*.swo
.history/

# === Python / Node (Caso use scripts de automação) ===
__pycache__/
node_modules/
dist/
build/

# === Legendarr: dados de runtime (gerados pelos containers) ===
03-apps/jellyfin/app/stats/*.json
03-apps/jellyfin/app/stats/*.bak
03-apps/jellyfin/app/jobs/*.json
