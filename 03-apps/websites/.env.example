# ==========================================================================
# Stack: websites — 3 sites estáticos (nginx), um por domínio.
# Copie para .env e ajuste:  cp .env.example .env
# NUNCA versione o .env.
# ==========================================================================

# Domínio raiz do homelab (sem subdomínio). Ex.: daberga.com
# Hosts servidos por esta stack:
#   ${DOMAIN}        -> web-daberga (apex)
#   lucas.${DOMAIN}  -> web-lucas
#   marina.${DOMAIN} -> web-marina
DOMAIN=daberga.com

# Caminho base no HOST para os arquivos dos sites.
# Cada site é servido de:  ${VOLUMES_BASE}/websites/published/<dominio>
# Ajuste para o caminho real do seu servidor.
VOLUMES_BASE=/mnt/storage/docker_volumes
