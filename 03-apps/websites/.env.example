# ==========================================================================
# Stack: websites — Silex (editor visual) + 3 sites estáticos (nginx)
# Copie para .env e ajuste os valores. NUNCA versione o .env.
#   cp .env.example .env
# ==========================================================================

# Domínio raiz do homelab (sem subdomínio). Ex.: daberga.com
# Subdomínios/hosts usados por esta stack:
#   studio.${DOMAIN}  -> editor Silex          (interno — internal-only)
#   ${DOMAIN}         -> site apex             (web-daberga, público)
#   lucas.${DOMAIN}   -> site do Lucas         (web-lucas, público)
#   marina.${DOMAIN}  -> site da Marina        (web-marina, público)
DOMAIN=daberga.com

# Caminho base no HOST para os volumes persistentes desta stack.
# Ajuste para o caminho real do seu servidor (ex.: /mnt/storage/docker_volumes).
# Os dados desta stack ficam em:
#   ${VOLUMES_BASE}/websites/storage      -> projetos/rascunhos do Silex
#   ${VOLUMES_BASE}/websites/published    -> saída estática publicada
VOLUMES_BASE=/mnt/storage/docker_volumes
