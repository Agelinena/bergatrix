# Immich — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.
#
# O OIDC (issuer, client ID e client secret) não fica aqui: o Immich guarda
# essa configuração no banco, e ela é feita na interface (veja o README).

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
PUID=1000
PGID=1000
APPDATA_PATH=/srv/appdata
CACHE_PATH=/srv/cache
USERDATA_PATH=/mnt/nas/userdata

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=immich
POSTGRES_USER=immich
# Só letras e números (exigência do Immich). Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Immich ────────────────────────────────────────────────────
# Opcional (padrão no compose: log). Valores: verbose, debug, log, warn, error
# IMMICH_LOG_LEVEL=debug
