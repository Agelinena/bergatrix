# Open WebUI + Ollama — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
APPDATA_PATH=/srv/appdata
CACHE_PATH=/srv/cache

# ── Open WebUI ────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=
# Mesma chave mestra do LiteLLM (03-apps/litellm/.env)
LITELLM_MASTER_KEY=
