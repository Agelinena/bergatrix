# Berganews — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata
CACHE_PATH=/srv/cache

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=berganews
POSTGRES_USER=berganews
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Sessões ───────────────────────────────────────────────────
# Assina os tokens do app e os links de imagem. Gere com: openssl rand -hex 32
BERGANEWS_JWT_SECRET=

# ── Login pelo Authentik (OIDC) ───────────────────────────────
# Passo a passo no README.md desta pasta.
BERGANEWS_OIDC_ISSUER=https://authentik.example.com/application/o/berganews/
BERGANEWS_SSO_CLIENT_ID=
BERGANEWS_SSO_CLIENT_SECRET=
# Grupos do Authentik: quem pode usar e quem administra.
# BERGANEWS_USERS_GROUP=berganews_users
# BERGANEWS_ADMINS_GROUP=berganews_admins

# ── IA local (Ollama, stack ollama) ───────────────────────────
# Modelos multilíngues que caibam na GPU junto com o resto. Antes de subir:
#   docker exec ollama ollama pull gemma3:4b
#   docker exec ollama ollama pull bge-m3
# Tradução (e, nas próximas fases, resumos e newsletter):
# BERGANEWS_AI_MODEL=gemma3:4b
# Embeddings das histórias: precisa gerar 1024 dimensões (bge-m3).
# BERGANEWS_EMBED_MODEL=bge-m3
# Quanto tempo o modelo fica na VRAM depois do último uso.
# BERGANEWS_AI_KEEP_ALIVE=2m
# Idiomas que o botão de traduzir alterna (o primeiro é o padrão de leitura).
# BERGANEWS_TRANSLATE_LANGUAGES=pt,en

# ── Histórias (opcionais; calibre pela tela de calibração) ─────
# Similaridade mínima para a matéria entrar numa história (com um nome
# próprio ou sigla em comum, no mesmo idioma).
# BERGANEWS_STORY_THRESHOLD=0.78
# Acima disso, entra mesmo sem nome em comum.
# BERGANEWS_STORY_STRONG=0.88
# Só junta matérias com até N horas de distância.
# BERGANEWS_STORY_WINDOW_HOURS=72

# ── Coleta (opcionais; padrões no compose) ────────────────────
# BERGANEWS_FETCH_INTERVAL_MINUTES=20
# Artigos que ninguém salvou somem depois de N dias.
# BERGANEWS_ARTICLE_RETENTION_DAYS=120
# BERGANEWS_LOG_LEVEL=INFO
