# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=pricebuddy
POSTGRES_USER=pricebuddy
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── PriceBuddy ────────────────────────────────────────────────
# Chave de criptografia do Laravel (sessões e dados cifrados). Não troque depois
# de subir: as sessões caem e o que foi cifrado fica ilegível.
# echo "base64:$(openssl rand -base64 32)"
PRICEBUDDY_APP_KEY=
# Lojas pré-cadastradas no primeiro início: all, usa ou australia
PRICEBUDDY_STORES_COUNTRY=all
# true troca links da Amazon/eBay pelos de afiliado do autor do PriceBuddy
PRICEBUDDY_AFFILIATE_ENABLED=false
