# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=pricebuddy
POSTGRES_USER=pricebuddy
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── PriceBuddy ────────────────────────────────────────────────
# Chave de criptografia do Laravel (sessões e dados cifrados). Não troque depois
# de subir: as sessões caem e o que foi cifrado fica ilegível.
# Gere com o sed abaixo, que grava direto no .env (o prefixo base64: é obrigatório):
# sed -i "s#^PRICEBUDDY_APP_KEY=.*#PRICEBUDDY_APP_KEY=base64:$(openssl rand -base64 32)#" .env
PRICEBUDDY_APP_KEY=
# Lojas pré-cadastradas no primeiro início (lojas/brasil.php)
PRICEBUDDY_STORES_COUNTRY=brasil
# true troca links da Amazon/eBay pelos de afiliado do autor do PriceBuddy
PRICEBUDDY_AFFILIATE_ENABLED=false

# ── Busca automática (SearXNG e buscador) ───────────────────
# openssl rand -hex 32
SEARXNG_SECRET=
# A cada quantos segundos o buscador roda, quantos produtos por rodada, depois de
# quantos dias procura de novo um produto, e no máximo quantas lojas acrescenta.
PRICEBUDDY_BUSCA_INTERVALO=600
PRICEBUDDY_BUSCA_POR_RODADA=5
PRICEBUDDY_BUSCA_REFAZER_DIAS=30
PRICEBUDDY_BUSCA_MAX_LOJAS=8
# Buscas dirigidas (site:loja ...) nas lojas que já vendem produtos parecidos.
PRICEBUDDY_BUSCA_SITE_LOJAS=4
# Sites desconhecidos classificados (loja, notícia...) por rodada.
PRICEBUDDY_BUSCA_DOMINIOS_POR_RODADA=5
# Lojas novas automáticas por rodada (0 desliga) e verificação das lojas
# automáticas (cada uma, uma vez por dia; 3 dias sem preço desativam).
PRICEBUDDY_LOJAS_NOVAS_POR_RODADA=3
PRICEBUDDY_LOJAS_VERIFICAR_POR_RODADA=5
# E-mail de ofertas de cada pessoa (menor preço em 90 dias, quedas de verdade,
# desconto de fachada) a cada N dias. 1 = diário (semana de Black Friday).
PRICEBUDDY_OFERTAS_DIAS=7

# ── IA local (Ollama da stack ollama, pela ponte "ia") ────────
# Só para os casos de dúvida (loja ou notícia? mesmo produto?). O modelo
# precisa estar baixado: docker exec ollama ollama pull gemma3:4b
# (o mesmo do Berganews: evita trocar de modelo na GPU). Vazio desliga a IA.
PRICEBUDDY_IA_URL=http://ia:11434
PRICEBUDDY_IA_MODELO=gemma3:4b
PRICEBUDDY_IA_POR_RODADA=20

# ── E-mail (relay smtp da stack) ──────────────────────────────
# Pode ser a mesma conta de SMTP do Authentik e do monitor.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
