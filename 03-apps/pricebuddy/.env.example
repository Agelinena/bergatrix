# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=pricebuddy
POSTGRES_USER=pricebuddy
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── PriceBuddy ────────────────────────────────────────────────
# Chave de criptografia do Laravel (sessões e dados cifrados). Não troque depois
# de subir: as sessões caem e o que foi cifrado fica ilegível.
# Gere com o sed abaixo, que grava direto no .env (o prefixo base64: é obrigatório):
# sed -i "s#^PRICEBUDDY_APP_KEY=.*#PRICEBUDDY_APP_KEY=base64:$(openssl rand -base64 32)#" .env
PRICEBUDDY_APP_KEY=
# Lojas pré-cadastradas no primeiro início (lojas/brasil.php)
PRICEBUDDY_STORES_COUNTRY=brasil
# true troca links da Amazon/eBay pelos de afiliado do autor do PriceBuddy
PRICEBUDDY_AFFILIATE_ENABLED=false

# ── E-mail (relay smtp da stack) ──────────────────────────────
# Pode ser a mesma conta de SMTP do Authentik e do monitor.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
