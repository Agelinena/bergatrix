# Volume base (caminho no host para dados persistentes)
VOLUMES_BASE=/mnt/storage/docker_volumes

# Domínios separados (Traefik)
WEB_DOMAIN=bergastream.seu-dominio.com
API_DOMAIN=bergastreamapi.seu-dominio.com
DEEMIX_DOMAIN=deemix.seu-dominio.com

# PostgreSQL
POSTGRES_DB=bergastream
POSTGRES_USER=bergastream
POSTGRES_PASSWORD=changeme_secure_password
DATABASE_URL=postgresql+asyncpg://bergastream:changeme_secure_password@bergastream-db:5432/bergastream

# Redis
REDIS_URL=redis://bergastream-redis:6379/0

# JWT
JWT_SECRET_KEY=changeme_very_long_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Fontes de música
DEEMIX_ARL=your_deezer_arl_token_here
DEEMIX_URL=http://bergastream-deemix:6595
DEEMIX_DOWNLOADS_PATH=/data/music/deemix_dl
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret

# UID/GID do usuário do host (para o container deemix)
PUID=1000
PGID=1000

# AI / recomendações
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-flash-1.5
LASTFM_API_KEY=your_lastfm_api_key

# Paths internos
MUSIC_PERMANENT_PATH=/data/music/permanent
MUSIC_CACHE_PATH=/data/music/cache
CACHE_EXPIRE_HOURS=48

# App
LOG_LEVEL=INFO
# Workers de download (defaults já estão bons para uso geral)
STREAM_WORKERS=2        # yt-dlp on-demand (streaming)
DEEMIX_BG_WORKERS=1    # MANTER EM 1 — deemix é single-consumer por design
YTDLP_BG_WORKERS=2     # yt-dlp background + fallback do deemix
MAX_YT_CONCURRENT=2    # semáforo global de processos yt-dlp simultâneos
# CORS: separar por vírgula se tiver mais de uma origem
CORS_ORIGINS=https://bergastream.seu-dominio.com
