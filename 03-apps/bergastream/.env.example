# -*- conf -*-
# Bergastream — variáveis de ambiente (copie para .env e preencha).
# Gere senhas/segredos com:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# Padrão das variáveis e das pastas: docs/03-padrao-stacks.md (raiz do repo).

# ── Base Bergatrix ────────────────────────────────────────────
# O app fica em bergastream.${DOMAIN}
DOMAIN=example.com
TZ=America/Sao_Paulo
# Dono dos arquivos baixados pelo Deemix e pelo Lidarr
PUID=1000
PGID=1000
# Banco, Redis e configs (Deemix, Lidarr, cookies): ${APPDATA_PATH}/bergastream
APPDATA_PATH=/srv/appdata
# Bibliotecas Python atualizadas pelo teste do Spotify: ${CACHE_PATH}/bergastream
CACHE_PATH=/srv/cache
# Músicas em ${MEDIA_PATH}/musica; downloads da Usenet em ${MEDIA_PATH}/downloads
# (a mesma pasta do SABnzbd do stack jellyfin)
MEDIA_PATH=/mnt/nas/media

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=bergastream
POSTGRES_USER=bergastream
POSTGRES_PASSWORD=troque_esta_senha
# Mesma senha de cima
DATABASE_URL=postgresql://bergastream:troque_esta_senha@db:5432/bergastream

# ── Deezer (Deemix) ───────────────────────────────────────────
# ARL: cookie "arl" do deezer.com logado (DevTools → Application → Cookies).
# A qualidade depende do plano da conta: grátis = MP3 128; Premium = MP3 320
# (no Brasil o Premium costuma incluir FLAC). Sob demanda o app pede 320; as
# faixas de playlist tentam FLAC.
DEEMIX_ARL=

# ── YouTube (plano B quando o Deemix falha) ──────────────────
# Opcional. Se os logs do worker mostrarem "Sign in to confirm you're not a
# bot" mesmo com os clientes alternativos, exporte os cookies (formato
# Netscape, ex.: extensão "Get cookies.txt LOCALLY") de uma conta SECUNDÁRIA
# do YouTube para ${APPDATA_PATH}/bergastream/youtube/cookies.txt (chmod 600) e defina:
# YT_COOKIES_FILE=/data/youtube/cookies.txt
YT_COOKIES_FILE=
# Gerador de PO Tokens (serviço pot-provider). Deixe como está; vazio desliga.
POT_PROVIDER_URL=http://bergastream-pot:4416

# ── Spotify ───────────────────────────────────────────────────
# Não precisa de conta nem de chave (caminho anônimo do web player). Um teste
# diário atualiza a biblioteca sozinho em ${CACHE_PATH}/bergastream/pydeps.

# ── Qualidade: FLAC das faixas de playlist pela Usenet (Lidarr) ──
# Serviço `lidarr` deste compose (interface em lidarr.${DOMAIN}, só rede
# local). Sem a chave = desligado (as playlists melhoram só pelo Deemix).
# Chave: Lidarr → Settings → General → API Key.
LIDARR_API_KEY=
# Depois de copiar a música, o resto do álbum é apagado do Lidarr; true mantém.
LIDARR_KEEP_ALBUMS=false
# Perfis por nome (vazio = o que tiver "Lossless"/"FLAC" no nome, ou o primeiro).
LIDARR_QUALITY_PROFILE=
LIDARR_METADATA_PROFILE=
# Busca na Usenet todo dia nos primeiros N dias do álbum no Lidarr; depois, semanal
# (entre uma e outra, o RSS do Lidarr pega o que aparecer).
UPGRADE_DAILY_DAYS=3
# Limites para não estourar a API do indexador: álbuns na fase diária ao mesmo
# tempo e buscas por 24 h (pedidos novos + repetições).
LIDARR_MAX_ACTIVE=30
LIDARR_DAILY_SEARCHES=100
# Parte das buscas diárias guardada para pedidos novos (as buscas repetidas
# dos álbuns já pedidos param ao chegar nela).
LIDARR_REQUEST_RESERVE=30

# ── Autenticação ──────────────────────────────────────────────
# Segredo dos tokens de login (obrigatório; trocar derruba todas as sessões)
JWT_SECRET=
# Criar conta pelo app (false = só pela linha de comando, docs/USUARIOS.md)
ALLOW_REGISTRATION=false

# ── Login pelo Authentik (OIDC) ───────────────────────────────
# Passo a passo do Authentik: docs/AUTHENTIK.md. Com ISSUER, CLIENT_ID e
# REDIRECT_URI preenchidos, o app mostra "Entrar com o Authentik". As contas
# atuais são ligadas no 1º login pelo mesmo nome de usuário (ou e-mail).
# Issuer: Authentik → Applications → Providers → bergastream → "OpenID
# Configuration Issuer" (com a barra final)
OIDC_ISSUER=
BERGASTREAM_SSO_CLIENT_ID=
BERGASTREAM_SSO_CLIENT_SECRET=
# Tem que ser igual à "Redirect URI" cadastrada no provider
OIDC_REDIRECT_URI=https://bergastream.example.com/api/auth/oidc/callback
# Endereço do Authentik na rede do Traefik (vazio = pelo endereço público)
OIDC_INTERNAL_URL=http://authentik-server:9000
# Grupo exigido para entrar (vazio = qualquer conta do Authentik) e grupo
# que vira administrador do Bergastream (vazio = não mexe no admin)
OIDC_REQUIRED_GROUP=bergastream_users
OIDC_ADMIN_GROUP=bergastream_admins
# Contas que ainda não existem no Bergastream são criadas no 1º login
OIDC_AUTO_CREATE=true
# Login por usuário e senha: auto (desliga quando o OIDC está configurado),
# true (mantém os dois) ou false
PASSWORD_LOGIN=auto

# ── E-mail (SMTP) ─────────────────────────────────────────────
# Avisos para as pessoas (senha trocada, convite, "esqueci minha senha").
# Pode ser a mesma conta de SMTP do Authentik (AUTHENTIK_EMAIL__* do stack
# authentik). Sem SMTP_HOST nada é enviado; o resto funciona igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Bergastream <bergastream@example.com>
# starttls (porta 587), ssl (porta 465) ou none (só rede interna)
SMTP_SECURITY=starttls
# Endereço público do app, usado nos links dos e-mails (vazio = o do
# OIDC_REDIRECT_URI)
APP_URL=https://bergastream.example.com
# Validade (horas) do link de "redefinir senha" e do convite
PASSWORD_RESET_HOURS=2
INVITE_HOURS=72

# ── Cache e logs ──────────────────────────────────────────────
CACHE_TTL_HOURS=48
LOG_LEVEL=INFO
