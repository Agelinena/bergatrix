# -*- conf -*-
# Bergastream — variáveis de ambiente (copie para .env e preencha).
# Gere senhas/segredos com:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# ── Servidor ──────────────────────────────────────────────────
# Pasta dos dados persistentes (banco, músicas, Redis, Deemix).
STORAGE_PATH=/mnt/storage/docker_data/bergastream
# Domínio do Traefik: o app fica em bergastream.${DOMAIN}
DOMAIN=daberga.com
# Dono dos arquivos baixados pelo Deemix
PUID=1000
PGID=1000

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=bergastream
POSTGRES_USER=bergastream
POSTGRES_PASSWORD=troque_esta_senha
# Mesma senha de cima
DATABASE_URL=postgresql://bergastream:troque_esta_senha@db:5432/bergastream

# ── Deezer (Deemix) ───────────────────────────────────────────
# ARL: cookie "arl" do deezer.com logado (DevTools → Application → Cookies)
DEEMIX_ARL=

# ── Spotify (opcional — sem ele a busca usa só o YouTube Music) ──
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Autenticação ──────────────────────────────────────────────
# Segredo dos tokens de login (obrigatório; trocar derruba todas as sessões)
JWT_SECRET=
# Criar conta pelo app (false = só pela linha de comando, docs/USUARIOS.md)
ALLOW_REGISTRATION=false

# ── Cache e logs ──────────────────────────────────────────────
CACHE_TTL_HOURS=48
LOG_LEVEL=INFO
