# Doberga — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=doberga
POSTGRES_USER=doberga
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Sessões ───────────────────────────────────────────────────
# Assina os tokens do app. Gere com: openssl rand -hex 32
DOBERGA_JWT_SECRET=

# ── Login pelo Authentik (OIDC) ───────────────────────────────
# Passo a passo no README.md desta pasta.
DOBERGA_OIDC_ISSUER=https://authentik.example.com/application/o/doberga/
DOBERGA_SSO_CLIENT_ID=
DOBERGA_SSO_CLIENT_SECRET=
# Grupos do Authentik: quem pode usar e quem administra.
# DOBERGA_USERS_GROUP=doberga_users
# DOBERGA_ADMINS_GROUP=doberga_admins

# ── App (opcionais) ───────────────────────────────────────────
# Abaixo desta versão o app pede para atualizar.
# DOBERGA_APP_MIN_VERSION=0.1.0
# Versão mais recente e onde baixar (oferecida no app).
# DOBERGA_APP_LATEST_VERSION=
# DOBERGA_APP_DOWNLOAD_URL=

# ── Sync (opcionais) ──────────────────────────────────────────
# Itens apagados somem de vez depois de N dias. Um aparelho parado por mais
# tempo baixa os espaços de novo, do zero (sem perder o que tinha para enviar).
# DOBERGA_SYNC_RETENTION_DAYS=90
# DOBERGA_LOG_LEVEL=INFO
