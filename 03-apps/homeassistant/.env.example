# ── Identidade / roteamento ───────────────────────────────
# Acesso em https://ha.${DOMAIN}
DOMAIN=daberga.com

# ── Armazenamento no host ─────────────────────────────────
# Config do HA fica em ${VOLUMES_BASE}/homeassistant/config
VOLUMES_BASE=/mnt/storage/docker_volumes

# ── Locale ────────────────────────────────────────────────
TZ=America/Sao_Paulo
