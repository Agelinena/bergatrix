# Domínio base (ex: bergaestudio.xyz → acesso em deemix.bergaestudio.xyz)
DOMAIN=seu-dominio.com

# ARL do Deezer (F12 → Application → Cookies → arl)
DEEMIX_ARL=seu_arl_aqui

# Path base dos volumes no host
VOLUMES_BASE=/mnt/storage/docker_volumes

# UID/GID do usuário do host (opcional, padrão 1000)
PUID=1000
PGID=1000
