# Transcriptor — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata
CACHE_PATH=/srv/cache

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=transcriptor
POSTGRES_USER=transcriptor
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Login pelo Authentik (OIDC) ───────────────────────────────
# Passo a passo no README.md desta pasta.
TRANSCRIPTOR_OIDC_ISSUER=https://authentik.example.com/application/o/transcriptor/
TRANSCRIPTOR_SSO_CLIENT_ID=
TRANSCRIPTOR_SSO_CLIENT_SECRET=
# Grupos do Authentik: quem pode usar e quem vê o estado do worker.
# TRANSCRIPTOR_USERS_GROUP=transcriptor_users
# TRANSCRIPTOR_ADMINS_GROUP=transcriptor_admins

# ── Limites (opcionais; padrões no compose) ───────────────────
# TRANSCRIPTOR_MAX_UPLOAD_MB=2048
# TRANSCRIPTOR_MAX_DURATION_MINUTES=240
# Transcrições somem depois de N dias (0 = só quando a pessoa apagar).
# TRANSCRIPTOR_RETENTION_DAYS=180
# Áudio para ouvir junto com o texto, em dias.
# TRANSCRIPTOR_AUDIO_DAYS=7

# ── Modelos (opcionais; catálogo em app/catalog.py) ───────────
# TRANSCRIPTOR_MODELS=small,turbo,large-v3
# TRANSCRIPTOR_DEFAULT_MODEL=turbo
# Minutos sem uso até o modelo sair da VRAM (a GPU é dividida com o Jellyfin e o Ollama).
# TRANSCRIPTOR_IDLE_UNLOAD_MINUTES=5
