# Domínio base para o Traefik
DOMAIN=seudominio.com

# Chave de API para proteger a aplicação
API_KEY=sua-chave-super-secreta

# Diretório raiz para arquivos locais (montado no container em /media)
ROOT_DIR=/caminho/para/sua/midia

# Diretório para acesso de dados persistentes do app
TRANSCRIPTOR_DATA_DIR=./data
