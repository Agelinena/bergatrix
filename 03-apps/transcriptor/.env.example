# Transcriptor — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
APPDATA_PATH=/srv/appdata
CACHE_PATH=/srv/cache

# ── Transcriptor ──────────────────────────────────────────────
# Chave da API v1 (header X-API-Key). Gere com: openssl rand -hex 32
TRANSCRIPTOR_API_KEY=
# Assina o identificador de usuário da interface web. Gere com: openssl rand -hex 32
TRANSCRIPTOR_SECRET_KEY=

# ── Serviços externos ─────────────────────────────────────────
# Token do Hugging Face (download dos modelos Whisper)
HF_TOKEN=
