# Domínio base do stack (ex: bergaestudio.xyz)
DOMAIN=seudominio.xyz

# ─── LiteLLM Auth ─────────────────────────────────────────────────────────────
# Master key da API — usada em todas as chamadas (deve começar com "sk-")
LITELLM_MASTER_KEY=sk-sua-master-key-aqui

# Salt key para criptografar virtual keys no DB (deve começar com "sk-")
LITELLM_SALT_KEY=sk-seu-salt-key-aqui

# Credenciais de acesso à UI web (/ui)
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=senha-segura-aqui

# ─── Banco de Dados (Postgres) ────────────────────────────────────────────────
# Senha do usuário "litellm" no Postgres
LITELLM_DB_PASSWORD=senha-db-segura-aqui

# Path no host para persistência dos dados do Postgres
LITELLM_DATA_DIR=/mnt/storage/docker_volumes/litellm

# ─── Provedores de IA ─────────────────────────────────────────────────────────
# API Key da OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# ─── Sidecar: Sync de Modelos Free ────────────────────────────────────────────
# Intervalo em segundos entre ciclos de sync (padrão: 3600 = 1 hora)
LITELLM_SYNC_INTERVAL=3600
