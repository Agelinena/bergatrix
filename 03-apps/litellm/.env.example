# LiteLLM — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
APPDATA_PATH=/srv/appdata

# ── Banco ─────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── LiteLLM ───────────────────────────────────────────────────
# Chave mestra da API (precisa começar com "sk-"): sk-$(openssl rand -hex 24)
LITELLM_MASTER_KEY=
# Criptografa as chaves de provedores guardadas no banco. Não troque depois.
LITELLM_SALT_KEY=
LITELLM_UI_USERNAME=
LITELLM_UI_PASSWORD=
# Intervalo (s) do sincronizador de modelos OpenRouter/Ollama
LITELLM_SYNC_INTERVAL=3600

# ── Serviços externos ─────────────────────────────────────────
OPENROUTER_API_KEY=
