# n8n — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata

# ── n8n ───────────────────────────────────────────────────────
# Criptografa as credenciais salvas no n8n. Não troque depois.
N8N_ENCRYPTION_KEY=
