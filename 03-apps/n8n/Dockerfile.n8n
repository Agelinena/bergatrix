FROM n8nio/n8n:latest
USER root

COPY --from=alpine:3.22 /sbin/apk /sbin/apk
COPY --from=alpine:3.22 /lib/apk /lib/apk
COPY --from=alpine:3.22 /etc/apk /etc/apk
COPY --from=alpine:3.22 /usr/share/apk /usr/share/apk

RUN apk add --no-cache python3 py3-pip

RUN pip3 install --break-system-packages --no-cache-dir \
    youtube-transcript-api \
    yt-dlp \
    cryptography

RUN mkdir -p /scripts && chmod 777 /scripts

RUN python3 --version && echo "Python OK"

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    N8N_ALLOW_EXEC=true

USER node
