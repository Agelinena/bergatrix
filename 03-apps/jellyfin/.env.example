DOMAIN=example.com
STORAGE_PATH=/path/to/jellyflix
PUID=1000
PGID=1000
TZ=America/Sao_Paulo
# --- Tradução de legendas 100% LOCAL (Ollama) ---
# Endpoint do Ollama (mesma rede docker bergatrix-proxy do OpenWebUI/Ollama).
LOCAL_AI_URL=http://ollama:11434
# Dois papéis: DIRETOR lê uma amostra do filme e gera um briefing de tom/registro/termos
# (roda 1x por legenda); TRADUTOR traduz os blocos em PT-BR seguindo o briefing.
DIRECTOR_MODEL=qwen2.5:7b
TRANSLATOR_MODEL=translategemma:4b
# DIRECTOR_ENABLED=false desliga o diretor (traduz direto, sem briefing de contexto).
DIRECTOR_ENABLED=true
# Quantas falas (amostradas ao longo do filme) o diretor recebe para montar o briefing.
DIRECTOR_SAMPLE_LINES=180
# Janela de contexto e timeout do Ollama (s). Suba OLLAMA_TIMEOUT se a 1ª carga do modelo demorar.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600
# Temperaturas: tradutor baixo (fidelidade), diretor um pouco maior (análise).
TRANSLATOR_TEMPERATURE=0.2
DIRECTOR_TEMPERATURE=0.5
# Revisão por bloco: blocos não traduzidos são reenviados até N rodadas (local é ilimitado).
BLOCK_RETRANSLATE_ROUNDS=3
# Blocos por requisição ao tradutor (lotes menores cabem melhor no contexto/VRAM).
TRANSLATE_BATCH_BLOCKS=60
# Cobertura mínima de blocos p/ considerar a tradução completa; abaixo disso é descartada e refeita.
TRANSLATION_MIN_BLOCK_COVERAGE=0.90
SCAN_INTERVAL=3600
# Cooldown progressivo p/ legendas que falham (Bazarr + IA):
# revisita a cada RETRY_INTERVAL_HOURS; após MAX_FAST_RETRIES falhas, espera COOLDOWN_HOURS
RETRY_INTERVAL_HOURS=1
MAX_FAST_RETRIES=6
COOLDOWN_HOURS=72
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=your_bazarr_api_key_here
# Código de idioma do Bazarr. "pb" = Brazilian Portuguese (use "pt" p/ Português europeu)
BAZARR_LANGUAGE=pb
BAZARR_WAIT_SECONDS=120

# --- Verificador de áudio (idioma original) ---
# Necessário para deletar + rebaixar quando falta o áudio no idioma original
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key_here
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key_here
# true = também rejeita quando só há faixas de áudio sem tag de idioma ('und')
AUDIO_CHECK_STRICT=false
# Máximo de re-downloads por mídia antes de desistir (evita loop infinito)
MAX_REDOWNLOAD_ATTEMPTS=5
# Tag (no Radarr/Sonarr) que ISENTA o item da verificação de áudio — marque um
# filme/série com esta tag para mantê-lo dublado/em outro idioma de propósito
AUDIO_KEEP_TAG=keep-audio
# Duração mínima (% do runtime conhecido pelo Radarr/Sonarr) p/ não tratar como cortado
MIN_DURATION_PERCENT=80
# Auditoria de legendas: legenda PT-BR que cobre menos que esta fração do filme
# (último timestamp ÷ duração) é tratada como incompleta → apagada e refeita do zero.
SUBTITLE_MIN_COVERAGE=0.85
# Downloads travados (stalled): remove do client + blocklista + rebaixa após N minutos
STALLED_TIMEOUT_MINUTES=5
STALLED_CHECK_INTERVAL=60
