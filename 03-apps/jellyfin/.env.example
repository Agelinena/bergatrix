DOMAIN=example.com
STORAGE_PATH=/path/to/jellyflix
PUID=1000
PGID=1000
TZ=America/Sao_Paulo
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Modelo pago preferencial
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# Fallback gratuito (CSV) quando o pago fica sem créditos. Vazio = usa o default do código
# (deepseek-chat-v3:free, llama-3.3-70b:free, qwen-2.5-72b:free, gemini-2.0-flash:free)
OPENROUTER_FREE_MODELS=
# Quantos modelos gratuitos tentar antes de desistir de um trecho
MAX_FREE_FALLBACKS=3
SCAN_INTERVAL=3600
# Horas de cooldown antes de retentar um arquivo já processado (evita reprocessamento em loop)
COOLDOWN_HOURS=72
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=your_bazarr_api_key_here
# Código de idioma do Bazarr. "pb" = Brazilian Portuguese (use "pt" p/ Português europeu)
BAZARR_LANGUAGE=pb
BAZARR_WAIT_SECONDS=120

# --- Verificador de áudio (idioma original) ---
# Necessário para deletar + rebaixar quando falta o áudio no idioma original
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key_here
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key_here
# true = também rejeita quando só há faixas de áudio sem tag de idioma ('und')
AUDIO_CHECK_STRICT=false
# Máximo de re-downloads por mídia antes de desistir (evita loop infinito)
MAX_REDOWNLOAD_ATTEMPTS=5
