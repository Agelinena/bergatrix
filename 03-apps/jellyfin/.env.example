DOMAIN=example.com
STORAGE_PATH=/path/to/jellyflix
PUID=1000
PGID=1000
TZ=America/Sao_Paulo
# --- Tradução de legendas 100% LOCAL (Ollama) ---
# Endpoint do Ollama (mesma rede docker bergatrix-proxy do OpenWebUI/Ollama).
LOCAL_AI_URL=http://ollama:11434
# Modelo tradutor (PT-BR). translategemma:4b é focado em tradução e cabe folgado na GPU.
TRANSLATOR_MODEL=translategemma:4b
# Janela de contexto e timeout do Ollama (s). Suba OLLAMA_TIMEOUT se a 1ª carga do modelo demorar.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600
# Temperatura do tradutor: baixa para priorizar fidelidade.
TRANSLATOR_TEMPERATURE=0.2
# Revisão por bloco: blocos não traduzidos são reenviados até N rodadas (local é ilimitado).
BLOCK_RETRANSLATE_ROUNDS=3
# Blocos por requisição ao tradutor (lotes menores cabem melhor no contexto/VRAM).
TRANSLATE_BATCH_BLOCKS=60
# Cobertura mínima de blocos p/ considerar a tradução completa; abaixo disso é descartada e refeita.
TRANSLATION_MIN_BLOCK_COVERAGE=0.90
# Rótulo da faixa no Jellyfin p/ legendas geradas por IA (ex.: "Português - AI").
# Legendas do Bazarr NÃO recebem rótulo. Evite "IA" (colide com Interlingua, código 'ia');
# "AI" é seguro. Deixe vazio para desativar (salva como .por.srt).
AI_SUBTITLE_LABEL=AI
SCAN_INTERVAL=3600
# Tempo sem alterações antes de processar uma legenda PT/PT-BR/PB recém-criada.
SUBTITLE_WATCH_DEBOUNCE=3
# O mapa temporal é rejeitado acima destes deslocamentos para não aceitar uma
# sincronização estruturalmente plausível, mas visualmente incorreta.
ALIGNMENT_MAX_AVERAGE_DELTA=8
ALIGNMENT_MAX_DELTA=60
# --- Refino de sincronia por conteúdo (após o sync do Bazarr/ALASS) ---
# Para legendas de OUTRO release (HDTV × WEB-DL, cortes diferentes): casa as falas PT
# com a legenda embutida via embeddings, estima a curva de deslocamento ao longo do
# episódio (deriva + saltos nos cortes) e a aplica a todas as falas, preservando o
# tempo interno do tradutor. Texto nunca muda. off | audit (só relatório em
# stats/subtitle_refine.json) | fix (corrige quando passa nos portões; backup .pre-refine).
SUBTITLE_REFINE=audit
# Modelo de embedding multilíngue no Ollama (~1,2 GB VRAM). Puxe antes:
#   docker exec ollama ollama pull bge-m3
REFINE_EMBED_MODEL=bge-m3
# Quanto tempo o modelo fica na VRAM após o uso (libera a GPU p/ tradutor/Jellyfin).
REFINE_EMBED_KEEP_ALIVE=2m
# Distância máxima (s) entre a fala PT (já pré-alinhada) e a candidata da referência.
REFINE_WINDOW_SECONDS=12
# Deslocamento perceptível (s): abaixo disto a curva é ruído e a legenda não é reescrita.
REFINE_TOLERANCE_SECONDS=0.25
# Fração mínima de falas casadas com confiança para aplicar a correção.
REFINE_MIN_MATCH=0.6
# Velocidade máxima de leitura (caracteres/s). Falas mais rápidas têm o FIM estendido
# para o espaço livre até a próxima fala (o início, que é a sincronia, não muda).
REFINE_MAX_CPS=17
# Cooldown progressivo p/ legendas que falham (Bazarr + IA):
# revisita a cada RETRY_INTERVAL_HOURS; após MAX_FAST_RETRIES falhas, espera COOLDOWN_HOURS
RETRY_INTERVAL_HOURS=1
MAX_FAST_RETRIES=6
COOLDOWN_HOURS=72
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=your_bazarr_api_key_here
# Código de idioma do Bazarr. "pb" = Brazilian Portuguese (use "pt" p/ Português europeu)
BAZARR_LANGUAGE=pb
BAZARR_WAIT_SECONDS=120
# Monitoramento do job assíncrono de sincronização do Bazarr.
BAZARR_SYNC_TIMEOUT=900
BAZARR_SYNC_POLL_SECONDS=10
BAZARR_SYNC_DISCOVERY_SECONDS=20

# --- Verificador de áudio (idioma original) ---
# Necessário para deletar + rebaixar quando falta o áudio no idioma original
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key_here
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key_here
# true = também rejeita quando só há faixas de áudio sem tag de idioma ('und')
AUDIO_CHECK_STRICT=false
# Máximo de re-downloads por mídia antes de desistir (evita loop infinito)
MAX_REDOWNLOAD_ATTEMPTS=5
# Tag (no Radarr/Sonarr) que ISENTA o item da verificação de áudio — marque um
# filme/série com esta tag para mantê-lo dublado/em outro idioma de propósito
AUDIO_KEEP_TAG=keep-audio
# Duração mínima (% do runtime conhecido pelo Radarr/Sonarr) p/ não tratar como cortado
MIN_DURATION_PERCENT=80
# Auditoria de legendas: legenda PT-BR que cobre menos que esta fração do filme
# (último timestamp ÷ duração) é tratada como incompleta → apagada e refeita do zero.
SUBTITLE_MIN_COVERAGE=0.85
# Downloads travados (stalled): remove do client + blocklista + rebaixa após N minutos
STALLED_TIMEOUT_MINUTES=5
STALLED_CHECK_INTERVAL=60
