# Nextcloud — copie para .env e preencha. Padrão das variáveis: docs/03-padrao-stacks.md
# Repositório público: nada de domínio, IP ou segredo real aqui.

# ── Base Bergatrix ────────────────────────────────────────────
DOMAIN=example.com
TZ=America/Sao_Paulo
APPDATA_PATH=/srv/appdata
USERDATA_PATH=/mnt/nas/userdata

# ── Banco ─────────────────────────────────────────────────────
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
NEXTCLOUD_REDIS_PASSWORD=

# ── Nextcloud ─────────────────────────────────────────────────
# Admin local criado na instalação (só vale na primeira subida). Preencha os
# dois antes do primeiro `up`. Depois que a sua conta do Authentik virar
# admin, este usuário é desativado (README).
NEXTCLOUD_ADMIN_USER=admin-local
# Gere com: openssl rand -hex 24
NEXTCLOUD_ADMIN_PASSWORD=
# Opcionais (padrão no compose: 512M). O app e os clientes enviam arquivos
# em pedaços, então o limite de upload só vale para envios sem pedaços.
# NEXTCLOUD_PHP_MEMORY_LIMIT=1G
# NEXTCLOUD_PHP_UPLOAD_LIMIT=16G

# ── SSO pelo Authentik (OIDC) ─────────────────────────────────
# Do provider "nextcloud" no Authentik (Applications → Providers). Não entram
# no container: são usados só pelo comando occ do README, que grava o
# provider no banco do Nextcloud.
NEXTCLOUD_SSO_CLIENT_ID=
NEXTCLOUD_SSO_CLIENT_SECRET=
