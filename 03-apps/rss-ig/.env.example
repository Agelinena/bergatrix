# ── Domain ────────────────────────────────────────────────────────────────────
# Traefik expõe o feed RSS em: https://rss-ig.${DOMAIN}
DOMAIN=example.com

# ── Instagram credentials ─────────────────────────────────────────────────────
# Conta secundária dedicada ao scraping
IG_USERNAME=your_scraper_account
IG_PASSWORD=your_password

# User-Agent enviado nas requisições ao Instagram CDN (opcional).
# Deixe em branco para usar o padrão do instaloader.
IG_USER_AGENT=

# ── Storage ───────────────────────────────────────────────────────────────────
# Diretório base no host para todos os dados persistentes.
# Subpastas criadas automaticamente: media/, feeds/, session/
# Exemplo: /opt/appdata/instaloader/
INSTALOADER_DATA_DIR=/opt/appdata/instaloader/

# ── Feed URLs ─────────────────────────────────────────────────────────────────
# URL pública base usada nos <enclosure> e <img src> do RSS.
# Deve coincidir com o host Traefik acima.
RSS_BASE_URL=https://rss-ig.example.com

# ── Scraper settings ──────────────────────────────────────────────────────────
# Janela de lookback para novas postagens (dias)
SCRAPE_DAYS=7

# Intervalo entre execuções do scheduler (horas).
# Dentro de cada execução os perfis são processados sequencialmente
# com delay aleatório de 30–180s entre eles.
SCHEDULE_INTERVAL_HOURS=2
